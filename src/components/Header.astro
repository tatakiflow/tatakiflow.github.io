---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: '~/about', href: '/' },
  { label: '~/writeups', href: '/writeups' },
  { label: '~/blog', href: '/blog' },
  { label: '~/notes', href: '/notes' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="border-b border-[#30363d] pb-6 mb-8">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="flex items-center space-x-2">
      <span class="text-[#3fb950] font-semibold">tatakiflow@sec</span>
      <span class="text-[#8b949e]">:</span>
      <span class="text-[#58a6ff]">~</span>
      <span class="text-[#8b949e]">$</span>
      <span class="inline-block w-2 h-4 bg-[#3fb950] animate-pulse ml-1"></span>
    </div>

    <nav aria-label="Main Navigation">
      <ul class="flex flex-wrap items-center gap-2 sm:gap-4 text-sm">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                class={`px-2.5 py-1 rounded transition-colors ${
                  active
                    ? 'bg-[#21262d] text-[#3fb950] border border-[#30363d] font-semibold'
                    : 'text-[#8b949e] hover:text-[#c9d1d9] hover:bg-[#161b22]'
                }`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
