---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const formatDate = (date: Date) => date.toISOString().split('T')[0];
---

<Layout title="Blog" description="Articles about artificial intelligence, programming, and cybersecurity.">
  <h1>Blog</h1>
  <p>Articles on cybersecurity, artificial intelligence, and programming.</p>

  {posts.length === 0 ? (
    <p>No articles published yet.</p>
  ) : (
    <ul>
      {posts.map((entry) => (
        <li>
          <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
          {' - '}
          <a href={`/blog/${entry.id}`}>{entry.data.title}</a>
          {entry.data.description && <p><small>{entry.data.description}</small></p>}
        </li>
      ))}
    </ul>
  )}
</Layout>
