---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const formatDate = (date: Date) => date.toISOString().split('T')[0];
---

<Layout title="Blog" description="Artículos sobre IA, programación, ciberseguridad y análisis técnico.">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#30363d] pb-4 gap-2">
      <div>
        <div class="text-xs text-[#8b949e] mb-1 font-mono">tatakiflow@sec:~/blog$ ls -lt</div>
        <h1 class="text-xl font-bold text-[#f0f6fc]">Blog & Artículos</h1>
      </div>
      <span class="text-xs font-mono text-[#8b949e]">
        Total: <span class="text-[#58a6ff] font-semibold">{posts.length}</span> articulos
      </span>
    </div>

    <div class="space-y-4 font-mono">
      {posts.map((post) => (
        <article class="p-4 rounded-lg border border-[#30363d] bg-[#161b22]/40 hover:bg-[#161b22] hover:border-[#58a6ff] transition-all">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h2 class="text-base font-semibold text-[#f0f6fc]">
              <a href={`/blog/${post.id}`} class="hover:text-[#58a6ff] transition-colors">
                {post.data.title}
              </a>
            </h2>
            <time datetime={post.data.publishDate.toISOString()} class="text-xs text-[#8b949e] shrink-0">
              {formatDate(post.data.publishDate)}
            </time>
          </div>

          {post.data.description && (
            <p class="text-xs text-[#8b949e] mb-3 leading-relaxed">
              {post.data.description}
            </p>
          )}

          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-[#30363d]/40">
              {post.data.tags.map((tag) => (
                <span class="text-[11px] px-1.5 py-0.5 rounded bg-[#0d1117] text-[#8b949e] border border-[#30363d]">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</Layout>
