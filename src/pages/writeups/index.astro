---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const writeups = (await getCollection('writeups')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const formatDate = (date: Date) => date.toISOString().split('T')[0];

const getDifficultyClass = (diff: string) => {
  switch (diff) {
    case 'Easy':
      return 'text-[#3fb950] border-[#238636] bg-[#238636]/10';
    case 'Medium':
      return 'text-[#d29922] border-[#9e6a03] bg-[#9e6a03]/10';
    case 'Hard':
      return 'text-[#f85149] border-[#da3633] bg-[#da3633]/10';
    case 'Insane':
      return 'text-[#a371f7] border-[#8957e5] bg-[#8957e5]/10';
    default:
      return 'text-[#8b949e] border-[#30363d] bg-[#161b22]';
  }
};
---

<Layout title="HTB Write-ups" description="Write-ups y resolución de máquinas de Hack The Box.">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#30363d] pb-4 gap-2">
      <div>
        <div class="text-xs text-[#8b949e] mb-1 font-mono">tatakiflow@sec:~/writeups$ ls -la</div>
        <h1 class="text-xl font-bold text-[#f0f6fc]">Hack The Box Write-ups</h1>
      </div>
      <span class="text-xs font-mono text-[#8b949e]">
        Total: <span class="text-[#3fb950] font-semibold">{writeups.length}</span> maquinas
      </span>
    </div>

    <div class="space-y-3 font-mono">
      {writeups.map((machine) => (
        <a
          href={`/writeups/${machine.id}`}
          class="group block p-4 rounded-lg border border-[#30363d] bg-[#161b22]/40 hover:bg-[#161b22] hover:border-[#58a6ff] transition-all"
        >
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="flex items-center space-x-2">
                <span class={`text-xs px-2 py-0.5 rounded border ${getDifficultyClass(machine.data.difficulty)} font-semibold`}>
                  {machine.data.difficulty}
                </span>
                <span class="text-xs px-2 py-0.5 rounded border border-[#30363d] bg-[#21262d] text-[#c9d1d9]">
                  {machine.data.os}
                </span>
                <h2 class="text-base font-semibold text-[#f0f6fc] group-hover:text-[#58a6ff] transition-colors ml-1">
                  {machine.data.title}
                </h2>
              </div>
              {machine.data.description && (
                <p class="text-xs text-[#8b949e] line-clamp-1">{machine.data.description}</p>
              )}
            </div>

            <div class="flex items-center space-x-4 text-xs text-[#8b949e] self-end md:self-center">
              {machine.data.ip && (
                <span class="text-[#58a6ff]">{machine.data.ip}</span>
              )}
              <span>{formatDate(machine.data.publishDate)}</span>
            </div>
          </div>

          {machine.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-[#30363d]/50">
              {machine.data.tags.map((tag) => (
                <span class="text-[11px] px-1.5 py-0.5 rounded bg-[#0d1117] text-[#8b949e] border border-[#30363d]">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </div>
</Layout>
