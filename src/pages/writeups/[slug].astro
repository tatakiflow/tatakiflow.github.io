---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatDate = (date: Date) => date.toISOString().split('T')[0];
---

<Layout title={entry.data.title} description={entry.data.description}>
  <p><a href="/writeups">&larr; Back to Writeups</a></p>

  <header>
    <h1>{entry.data.title}</h1>
    <p>
      <small>
        Date: <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
        {' '}&bull; OS: {entry.data.os}
        {' '}&bull; Difficulty: {entry.data.difficulty}
        {entry.data.ip && ` &bull; IP: ${entry.data.ip}`}
      </small>
    </p>
  </header>

  <article>
    <Content />
  </article>

  <hr />
  <p><a href="/writeups">&larr; Back to Writeups</a></p>
</Layout>
