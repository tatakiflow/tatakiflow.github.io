---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const formatDate = (date: Date) => date.toISOString().split('T')[0];

const notesByCategory = notes.reduce((acc, note) => {
  const cat = note.data.category || 'General';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(note);
  return acc;
}, {} as Record<string, typeof notes>);

const categories = Object.keys(notesByCategory).sort();
---

<Layout title="Notes" description="Cybersecurity cheatsheets and reference notes.">
  <h1>Technical Notes & Cheatsheets</h1>
  <p>Reference guides, commands, and cheatsheets organized by topic.</p>

  {categories.length === 0 ? (
    <p>No notes published yet.</p>
  ) : (
    categories.map((category) => (
      <section>
        <h2>{category}</h2>
        <ul>
          {notesByCategory[category].map((entry) => (
            <li>
              <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
              {' - '}
              <a href={`/notes/${entry.id}`}>{entry.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</Layout>
