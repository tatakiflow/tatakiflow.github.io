---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const writeups = (await getCollection('writeups')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const formatDate = (date: Date) => date.toISOString().split('T')[0];
---

<Layout title="About">
  <section>
    <h1>About Me</h1>
    <p>
      I am a cybersecurity enthusiast focused on offensive security, penetration testing, and software development.
      This site serves as an index for my Hack The Box writeups, technical notes, and research on AI and programming.
    </p>
  </section>

  <section>
    <h2>Latest HTB Writeups</h2>
    {writeups.length === 0 ? (
      <p>No writeups published yet.</p>
    ) : (
      <ul>
        {writeups.slice(0, 5).map((entry) => (
          <li>
            <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
            {' - '}
            <a href={`/writeups/${entry.id}`}>{entry.data.title}</a>
            {' '}[{entry.data.os}, {entry.data.difficulty}]
          </li>
        ))}
      </ul>
    )}
    <p><a href="/writeups">All writeups &rarr;</a></p>
  </section>

  <section>
    <h2>Latest Articles</h2>
    {blogPosts.length === 0 ? (
      <p>No articles published yet.</p>
    ) : (
      <ul>
        {blogPosts.slice(0, 5).map((entry) => (
          <li>
            <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
            {' - '}
            <a href={`/blog/${entry.id}`}>{entry.data.title}</a>
          </li>
        ))}
      </ul>
    )}
    <p><a href="/blog">All articles &rarr;</a></p>
  </section>

  <section>
    <h2>Latest Notes</h2>
    {notes.length === 0 ? (
      <p>No notes published yet.</p>
    ) : (
      <ul>
        {notes.slice(0, 5).map((entry) => (
          <li>
            <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate)}</time>
            {' - '}
            <a href={`/notes/${entry.id}`}>{entry.data.title}</a>
            {' '}[{entry.data.category}]
          </li>
        ))}
      </ul>
    )}
    <p><a href="/notes">All notes &rarr;</a></p>
  </section>
</Layout>
