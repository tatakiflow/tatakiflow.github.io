---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Cybersecurity notes and Hack The Box writeups.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} - tatakiflow</title>
  </head>
  <body>
    <div class="container">
      <header>
        <strong>tatakiflow</strong>
        <nav>
          <a href="/">About</a>
          <a href="/writeups">HTB Writeups</a>
          <a href="/blog">Blog</a>
          <a href="/notes">Notes</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>tatakiflow &bull; <a href="https://github.com/tatakiflow" target="_blank" rel="noopener noreferrer">GitHub</a></p>
      </footer>
    </div>
  </body>
</html>
